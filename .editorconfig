root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 120

[*.go]
indent_style = tab
indent_size = 4

[*.{js,cjs,css,html,json,yaml,yml,proto,sh,command}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
