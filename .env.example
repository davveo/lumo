# Local development only. start.sh (or scripts/up.sh) creates .env when absent.
MYSQL_ROOT_PASSWORD=lumo_root_local_2026
MALL_DB_PASSWORD=lumo_db_local_2026
RABBITMQ_USER=mall
RABBITMQ_PASSWORD=lumo_mq_local_2026
MINIO_ACCESS_KEY=lumo_minio_local
MINIO_SECRET_KEY=lumo_minio_local_secret_2026
INTERNAL_RPC_TOKEN=lumo_rpc_local_only_change_before_shared_deploy_2026
DEMO_MODE=true
WEB_PORT=8080
GATEWAY_PORT=18080
# Docker DNS name and internal API port used by the frontend reverse proxy.
WEB_GATEWAY_UPSTREAM=gateway:8080
# Optional compatible cached base image; the default is the official pinned tag.
WEB_NGINX_IMAGE=nginx:1.30.6-alpine
# Node is used only during asset builds. Use the official ECR mirror to avoid
# Docker Hub token requests; override with a compatible local/registry image.
WEB_NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.4-alpine3.24
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
JAEGER_PORT=16686
RABBITMQ_UI_PORT=15672
CONSUL_UI_PORT=8500
# Optional ACL token for an ACL-enabled Consul deployment.
CONSUL_HTTP_TOKEN=
OTEL_TRACES_SAMPLER_ARG=1

# Browser POST-policy uploads: use your real app origin(s), comma separated.
MINIO_CORS_ORIGINS=http://localhost:${WEB_PORT:-8080},http://127.0.0.1:${WEB_PORT:-8080}
# Public browser-accessible MinIO endpoint; keep signed host unchanged.
MINIO_PUBLIC_ENDPOINT=localhost:${MINIO_API_PORT:-9001}

# Optional exact storefront origins for a separately hosted frontend; no wildcard.
# Example: https://your-private-site.chatgpt.site
CORS_ALLOWED_ORIGINS=

# Compose trusts only the frontend proxy's current DNS addresses. Direct Go
# deployments trust no proxy unless explicitly configured. CIDRs are optional.
TRUSTED_PROXY_HOSTS=web
TRUSTED_PROXY_CIDRS=

# Snowflake worker override for separately allocated writer groups (0..1023).
# Replicas sharing one domain database share its durable cursor by default.
SNOWFLAKE_NODE_ID=

# IAM provider credentials stay on the server; admin only switches ready channels.
IAM_OTP_HASH_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_REDIRECT_URI=
QQ_LOGIN_APP_ID=
QQ_LOGIN_APP_SECRET=
QQ_LOGIN_REDIRECT_URI=

# Optional independent AES-256 key for encrypted channel credentials (hex/base64).
# If empty, a purpose-derived key uses the existing private INTERNAL_RPC_TOKEN.
CHANNEL_CONFIG_ENCRYPTION_KEY=

# Verified email binding/recovery webhook; HTTPS and a server-side token.
IAM_EMAIL_WEBHOOK_URL=
IAM_EMAIL_WEBHOOK_TOKEN=

# Optional LUMO carrier adapter. Leave empty to keep explicit demo logistics.
LOGISTICS_CARRIER_PROVIDER=
LOGISTICS_CARRIER_CREATE_URL=
LOGISTICS_CARRIER_TOKEN=
# At least 32 characters; authenticates carrier event callbacks (HMAC-SHA256).
LOGISTICS_CARRIER_CALLBACK_KEY=
LOGISTICS_PICKUP_TIMEOUT_HOURS=24
LOGISTICS_STALE_TIMEOUT_HOURS=72
