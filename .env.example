# Local development only. start.sh (or scripts/up.sh) creates .env when absent.
MYSQL_ROOT_PASSWORD=lumo_root_local_2026
MALL_DB_PASSWORD=lumo_db_local_2026
RABBITMQ_USER=mall
RABBITMQ_PASSWORD=lumo_mq_local_2026
MINIO_ACCESS_KEY=lumo_minio_local
MINIO_SECRET_KEY=lumo_minio_local_secret_2026
INTERNAL_RPC_TOKEN=lumo_rpc_local_only_change_before_shared_deploy_2026
DEMO_MODE=true
GATEWAY_PORT=8080
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
JAEGER_PORT=16686
RABBITMQ_UI_PORT=15672
OTEL_TRACES_SAMPLER_ARG=1

# Browser POST-policy uploads: use your real app origin(s), comma separated.
MINIO_CORS_ORIGINS=http://localhost:${GATEWAY_PORT:-8080},http://127.0.0.1:${GATEWAY_PORT:-8080}
# Public browser-accessible MinIO endpoint; keep signed host unchanged.
MINIO_PUBLIC_ENDPOINT=localhost:${MINIO_API_PORT:-9001}

# Optional exact storefront origins for a separately hosted frontend; no wildcard.
# Example: https://your-private-site.chatgpt.site
CORS_ALLOWED_ORIGINS=
